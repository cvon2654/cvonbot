# Only needed if you want the dashboard to also show YOUR Kalshi balance/positions.
# Public market data (scores, prices, order books) needs none of this.
#
# Generate these under Kalshi -> Settings -> API Keys (see README "Getting a Kalshi API key").
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# "demo" (paper markets, safe to test against) or "prod" (real markets, still read-only here)
KALSHI_ENV=demo
